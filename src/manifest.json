{
  "manifest_version": 3,
  "name": "Tob the Trial Builder",
  "version": "0.1.0",
  "description": "Builds a clinical study specification into any eSource form designer, and asks a human about anything it cannot settle honestly.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/tob-16.png",
    "32": "icons/tob-32.png",
    "48": "icons/tob-48.png",
    "128": "icons/tob-128.png"
  },
  "action": {
    "default_title": "Tob the Trial Builder",
    "default_icon": {
      "16": "icons/tob-16.png",
      "32": "icons/tob-32.png",
      "48": "icons/tob-48.png",
      "128": "icons/tob-128.png"
    }
  },
  "side_panel": { "default_path": "panel.html" }
}
